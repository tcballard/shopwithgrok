# GrokShop local configuration. Copy to .env only if your process supervisor loads it.
# The MCP and HTTP entrypoints read the environment directly; they do not load .env themselves.
# These values are placeholders. None of them are live credentials.

# stub is the only supported mode. "live" throws and does not call a carrier.
GROKSHOP_SHIPPING_MODE=stub

# stub is the only supported mode. "stripe" throws and does not create a PaymentIntent.
GROKSHOP_PAYMENTS_MODE=stub

# Required for HTTP POST /checkouts/:id/approve. The CLI (`npm run approve`) does not use it.
# Generate a local string with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GROKSHOP_APPROVAL_SECRET=replace-with-a-long-random-local-secret

# HTTP mirror. Binds to localhost only unless you override the host.
GROKSHOP_HTTP_HOST=127.0.0.1
GROKSHOP_HTTP_PORT=39217

# Catalog feed. JSON ({ merchant, products }) or CSV. See README.
GROKSHOP_CATALOG_PATH=data/harbor-hex.sample.json

# Optional display name when a CSV feed has no "# merchant:" line.
GROKSHOP_MERCHANT_NAME=Harbor & Hex (SAMPLE)

# Shared by the MCP server, the HTTP server, the hosted server, and `npm run approve`.
# Checkouts, quoted rates, and the inventory_sold overlay. The catalog file is not rewritten.
# Hosted mode also stores accounts.json here (password hashes and API-key hashes, never plaintext keys)
# and one tenant directory per account.
GROKSHOP_DATA_DIR=.grokshop

# --- Hosted remote MCP (npm run start:remote) ---
# Railway sets PORT. Fly should set PORT=8080. When PORT is set and GROKSHOP_HTTP_HOST is unset, the remote server binds 0.0.0.0.
# PORT=8080
# GROKSHOP_HTTP_HOST=0.0.0.0

# Public origin shown on the signup page and in API responses. Keep the placeholder until a host exists.
# No custom domain is purchased by this repo.
GROKSHOP_PUBLIC_URL=https://YOUR_HOST

# Free tier quotas. Defaults are 50 tool calls/day and 5 checkouts/day.
# GROKSHOP_FREE_TOOL_CALLS_PER_DAY=50
# GROKSHOP_FREE_CHECKOUTS_PER_DAY=5

# The hosted server refuses to boot unless both modes are stub. It never calls Stripe or a carrier.
# GROKSHOP_CATALOG_PATH is ignored on the hosted free tier; the bundled Harbor & Hex SAMPLE catalog is always used.

# v1 does not send email. POST /signup and POST /login return the API key in the response.
# To send mail later, add a provider without committing secrets:
# GROKSHOP_EMAIL_PROVIDER=resend
# GROKSHOP_EMAIL_FROM=signup@YOUR_HOST
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
